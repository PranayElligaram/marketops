# Use a unique local database password. Never commit .env.
MARKETOPS_DB_PASSWORD=replace-with-a-local-password
MARKETOPS_ENVIRONMENT=development
MARKETOPS_LOG_LEVEL=INFO
MARKETOPS_API_PORT=8001
MARKETOPS_DASHBOARD_PORT=8503

# Leave blank for offline example-data mode. Only read-only permissions should be granted.
# Your keys must be created in Trading 212, never entered into a chat.
# Demo API credentials are separate from live API credentials.
MARKETOPS_T212_ENVIRONMENT=demo
# Live (real money) is refused unless BOTH environment=live and allow_live=true. Keep false for demo.
MARKETOPS_T212_ALLOW_LIVE=false
# Key needs only the read scopes 'account' and 'portfolio'. Never enable order/trading scopes.
MARKETOPS_T212_API_KEY=
MARKETOPS_T212_API_SECRET=

# Research agent: local Ollama only (loopback / host.docker.internal / "ollama" hosts are accepted).
MARKETOPS_OLLAMA_BASE_URL=http://127.0.0.1:11434
MARKETOPS_OLLAMA_MODEL=qwen3.5:4b
# Set true to let the agent read your Trading 212 positions (sent only to the local model).
MARKETOPS_AGENT_ALLOW_BROKER_PORTFOLIO=false
# Required (16+ chars) for ALL real Trading 212 data: /portfolio/overview, broker-backed agent
# runs and the agent audit log. Header: X-MarketOps-Token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = real brokerage access denied. Type it into the dashboard; it is not in its env.
MARKETOPS_AGENT_API_TOKEN=
# Optional: enables read-only SEC EDGAR filing metadata. SEC requires a descriptive User-Agent
# with your real contact, e.g. "Your Name you@example.com". Unset = endpoint reports unavailable.
MARKETOPS_SEC_USER_AGENT=
